        "jsCode": "// 1. Móc dữ liệu từ Error Trigger (nơi lưu giữ di chúc của request khi sập)\nconst errorData = $input.first().json;\nconst originalBody = errorData.execution?.error?.context?.request?.body || {};\n\n// 2. Nếu mất mạng, n8n thường báo lỗi 0 hoặc Timeout\nconst errorDesc = errorData.execution?.error?.description || \"Network Connection Lost\";\n\n// 3. Đóng gói payload trả về Next.js\nreturn {\n  job_id: originalBody.job_id || \"UNKNOWN_JOB\",\n  post_id: originalBody.post_id || \"UNKNOWN_POST\",\n  status: \"error\",\n  error_message: `Hệ thống PN OS phát hiện sự cố: ${errorDesc}`,\n  timestamp: new Date().toISOString()\n};"
