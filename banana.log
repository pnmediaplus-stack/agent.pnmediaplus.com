commit 3c3db5f8c98bb8744c73bb91e1b84b1e06bb2a90
Author: PN Media Plus <pnmediaplus@gmail.com>
Date:   Wed Aug 19 17:42:09 2026 +0700

    fix(llm): change nano-banana-2-lite to use standard_generations contract

diff --git a/supabase/migrations/20260819000005_phase077_kie_ai_request_contract_fix.sql b/supabase/migrations/20260819000005_phase077_kie_ai_request_contract_fix.sql
new file mode 100644
index 0000000..2fe7675
--- /dev/null
+++ b/supabase/migrations/20260819000005_phase077_kie_ai_request_contract_fix.sql
@@ -0,0 +1,17 @@
+-- Fix request_contract for nano-banana-2-lite
+
+UPDATE tenant_integration_vault.integration_providers
+SET public_metadata = jsonb_set(
+    public_metadata,
+    '{models}',
+    (
+        SELECT jsonb_agg(
+            CASE 
+                WHEN m->>'code' = 'nano-banana-2-lite' THEN m || '{"request_contract": "standard_generations"}'::jsonb
+                ELSE m
+            END
+        )
+        FROM jsonb_array_elements(public_metadata->'models') AS m
+    )
+)
+WHERE provider_code = 'kie_ai';

commit 8f5c670bd44ffb9cf0c9c41cde855a8537a1a7e8
Author: PN Media Plus <pnmediaplus@gmail.com>
Date:   Wed Aug 19 17:25:02 2026 +0700

    refactor(llm): remove fallback heuristic and enforce strict fail-closed contract check

diff --git a/supabase/migrations/20260819000004_phase077_kie_ai_request_contract.sql b/supabase/migrations/20260819000004_phase077_kie_ai_request_contract.sql
new file mode 100644
index 0000000..cf840d5
--- /dev/null
+++ b/supabase/migrations/20260819000004_phase077_kie_ai_request_contract.sql
@@ -0,0 +1,18 @@
+-- Add request_contract to Kie AI models to support strict fail-closed contract checking
+
+UPDATE tenant_integration_vault.integration_providers
+SET public_metadata = jsonb_set(
+    public_metadata,
+    '{models}',
+    (
+        SELECT jsonb_agg(
+            CASE 
+                WHEN m->>'code' = 'flux-kontext-pro' THEN m || '{"request_contract": "legacy_generate"}'::jsonb
+                WHEN m->>'code' = 'nano-banana-2-lite' THEN m || '{"request_contract": "jobs_create_task"}'::jsonb
+                ELSE m
+            END
+        )
+        FROM jsonb_array_elements(public_metadata->'models') AS m
+    )
+)
+WHERE provider_code = 'kie_ai';

