{
  "name": "Omnichannel CSKH AI Agent",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "omnichannel-cskh",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Webhook Trigger (From Next.js)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 0 ],
      "notesInFlow": true,
      "notes": "Nhận payload { organization_id, channel_id, customer_id, thread_id, message, sender_id }"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT bot_system_prompt, channel_external_id FROM public.crm_channels WHERE id = $1",
        "values": "={{ $('Webhook Trigger (From Next.js)').first().json.body.channel_id }}"
      },
      "id": "node-fetch-prompt",
      "name": "Fetch Dynamic System Prompt",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [ 200, 0 ],
      "notesInFlow": true,
      "notes": "Lấy cấu hình Persona của Fanpage/OA"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT tag_name FROM public.crm_tenant_tags WHERE organization_id = $1",
        "values": "={{ $('Webhook Trigger (From Next.js)').first().json.body.organization_id }}"
      },
      "id": "node-fetch-tags",
      "name": "Fetch Allowed Tags",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [ 400, 0 ],
      "notesInFlow": true,
      "notes": "Kéo danh sách thẻ để truyền vào Tool Update Tags"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"SUPABASE_URL\"] || '').replace(new RegExp('/$'), '') + '/rest/v1/rpc/phase076_find_tenant_integration' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $('Webhook Trigger (From Next.js)').first().json.body.organization_id }}"
            },
            {
              "name": "p_integration_key",
              "value": "={{ 'facebook_page_' + $('Fetch Dynamic System Prompt').first().json.channel_external_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-fetch-facebook-integration",
      "name": "Fetch Facebook Integration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 520, 0 ],
      "notesInFlow": true,
      "notes": "Lấy vault_credential_ref của Facebook Page từ tenant integration"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"NEXTJS_CONTROL_PLANE_BASE_URL\"] || '').replace(new RegExp('/$'), '') + '/api/byok/redeem' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-broker-internal-secret",
              "value": "={{ $env[\"BROKER_INTERNAL_SECRET\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reference_token",
              "value": "={{ $('Fetch Facebook Integration').first().json.vault_credential_ref }}"
            },
            {
              "name": "organization_id",
              "value": "={{ $('Webhook Trigger (From Next.js)').first().json.body.organization_id }}"
            },
            {
              "name": "integration_key",
              "value": "={{ 'facebook_page_' + $('Fetch Dynamic System Prompt').first().json.channel_external_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-redeem-facebook-token",
      "name": "Redeem BYOK Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 640, 0 ],
      "notesInFlow": true,
      "notes": "Đổi vault token ra access token thật để gửi Facebook"
    },
    {
      "parameters": {
        "text": "={{ $('Webhook Trigger (From Next.js)').first().json.body.message }}",
        "options": {
          "systemMessage": "={{ $node['Fetch Dynamic System Prompt'].json.bot_system_prompt }}"
        }
      },
      "id": "node-ai-agent",
      "name": "AI Agent (CSKH)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.1,
      "position": [ 600, 0 ],
      "notesInFlow": true,
      "notes": "Bộ não cốt lõi. Sẽ suy nghĩ và quyết định gọi Tools hay trả lời thẳng"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {
          "temperature": 0.4,
          "baseURL": "={{($env[\"API_BASE_URL\"] || \"https://agent.pnmediaplus.com\")}}/api/internal/llm-gateway/openai"
        }
      },
      "id": "node-openai-model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [ 600, 200 ]
    },
    {
      "parameters": {
        "tableName": "crm_messages",
        "sessionId": "={{ $('Webhook Trigger (From Next.js)').first().json.body.thread_id }}"
      },
      "id": "node-chat-memory",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1,
      "position": [ 750, 250 ],
      "notesInFlow": true,
      "notes": "Kéo lịch sử chat từ bảng crm_messages để Bot nhớ văn cảnh"
    },
    {
      "parameters": {},
      "id": "node-vector-rag",
      "name": "Vector Store (RAG)",
      "type": "@n8n/n8n-nodes-langchain.toolVectorStore",
      "typeVersion": 1,
      "position": [ 900, 200 ],
      "notesInFlow": true,
      "notes": "Tra cứu tài liệu nội bộ dựa trên organization_id trước khi trả lời"
    },
    {
      "parameters": {
        "name": "update_customer_needs",
        "description": "={{ 'Dùng để gán các thẻ phân loại sau: ' + JSON.stringify($node['Fetch Allowed Tags'].json.tags) }}",
        "method": "POST",
        "url": "https://agent.pnmediaplus.com/api/internal/customer/tags",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"CONTROL_PLANE_SECRET\"] }}"
            }
          ]
        }
      },
      "id": "node-tool-tags",
      "name": "Tool: Update Tags",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [ 1050, 250 ]
    },
    {
      "parameters": {
        "name": "request_human_handoff",
        "description": "Gọi tool này khi khách yêu cầu gặp người thật hoặc khi bạn không có dữ liệu để trả lời.",
        "method": "POST",
        "url": "https://agent.pnmediaplus.com/api/internal/thread/handoff",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"CONTROL_PLANE_SECRET\"] }}"
            }
          ]
        }
      },
      "id": "node-tool-handoff",
      "name": "Tool: Handoff to Human",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1,
      "position": [ 1200, 250 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v19.0/me/messages",
        "onError": "continueRegularOutput",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "access_token", "value": "={{ $('Redeem BYOK Token').first().json.data.access_token }}" },
            { "name": "recipient", "value": "={{ { id: $('Webhook Trigger (From Next.js)').first().json.body.sender_id } }}" },
            { "name": "message", "value": "={{ { text: $json.output } }}" }
          ]
        }
      },
      "id": "node-send-fb",
      "name": "Send Reply to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 900, 0 ]
    },
    {
      "parameters": {
        "operation": "insert",
        "tableName": "crm_messages",
        "columns": "organization_id,thread_id,sender_type,content,delivery_status",
        "values": {
          "organization_id": "={{ $('Webhook Trigger (From Next.js)').first().json.body.organization_id }}",
          "thread_id": "={{ $('Webhook Trigger (From Next.js)').first().json.body.thread_id }}",
          "sender_type": "bot",
          "content": "={{ $('AI Agent (CSKH)').first().json.output }}",
          "delivery_status": "={{ $json.error || ($json.statusCode && $json.statusCode >= 400) ? 'failed' : 'sent' }}"
        }
      },
      "id": "node-insert-outbound",
      "name": "Insert Outbound Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [ 1100, 0 ]
    }
  ],
  "connections": {
    "Webhook Trigger (From Next.js)": {
      "main": [ [ { "node": "Fetch Dynamic System Prompt", "type": "main", "index": 0 } ] ]
    },
    "Fetch Dynamic System Prompt": {
      "main": [ [ { "node": "Fetch Allowed Tags", "type": "main", "index": 0 } ] ]
    },
    "Fetch Allowed Tags": {
      "main": [ [ { "node": "Fetch Facebook Integration", "type": "main", "index": 0 } ] ]
    },
    "Fetch Facebook Integration": {
      "main": [ [ { "node": "Redeem BYOK Token", "type": "main", "index": 0 } ] ]
    },
    "Redeem BYOK Token": {
      "main": [ [ { "node": "AI Agent (CSKH)", "type": "main", "index": 0 } ] ]
    },
    "AI Agent (CSKH)": {
      "main": [ [ { "node": "Send Reply to Facebook", "type": "main", "index": 0 } ] ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [ [ { "node": "AI Agent (CSKH)", "type": "ai_languageModel", "index": 0 } ] ]
    },
    "Postgres Chat Memory": {
      "ai_memory": [ [ { "node": "AI Agent (CSKH)", "type": "ai_memory", "index": 0 } ] ]
    },
    "Vector Store (RAG)": {
      "ai_tool": [ [ { "node": "AI Agent (CSKH)", "type": "ai_tool", "index": 0 } ] ]
    },
    "Tool: Update Tags": {
      "ai_tool": [ [ { "node": "AI Agent (CSKH)", "type": "ai_tool", "index": 0 } ] ]
    },
    "Tool: Handoff to Human": {
      "ai_tool": [ [ { "node": "AI Agent (CSKH)", "type": "ai_tool", "index": 0 } ] ]
    },
    "Send Reply to Facebook": {
      "main": [ [ { "node": "Insert Outbound Message", "type": "main", "index": 0 } ] ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
