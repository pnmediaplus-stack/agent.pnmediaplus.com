        "url": "={{$env[\"API_BASE_URL\"]}}/api/n8n/publish-callback",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"action\": \"chat_append\",\n  \"organization_id\": \"{{$json.organization_id}}\",\n  \"thread_id\": \"{{$json.thread_id}}\",\n  \"content_item_id\": \"{{$json.content_item_id}}\",\n  \"department_id\": \"{{$json.department_id}}\",\n  \"idempotency_key\": \"{{$execution.id}}\",\n  \"content\": \"CMO Analysis Complete. Pivot Recommended: {{$json.aiResult.should_pivot}}\\n\\n**Reasoning:** {{$json.aiResult.reasoning}}\\n\\n**Proposed Direction:** {{$json.aiResult.proposed_direction}}\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-idempotency-key",
              "value": "={{$execution.id}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback (chat_append)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2700,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ControlPlaneAuth",
          "name": "Header Auth"
