        "jsonBody": "={\n  \"action\": \"chat_append\",\n  \"organization_id\": \"{{$('Webhook Trigger').item.json.body.organization_id}}\",\n  \"thread_id\": \"{{$('Webhook Trigger').item.json.body.thread_id}}\",\n  \"content_item_id\": \"{{$('Webhook Trigger').item.json.body.content_item_id}}\",\n  \"department_id\": \"{{$('Webhook Trigger').item.json.body.department_id}}\",\n  \"idempotency_key\": \"{{$execution.id}}_scope_error\",\n  \"content\": \"CMO Analysis Failed Scope Resolve.\\n\\n**Reason:** {{$json.reason}}\"\n}",
