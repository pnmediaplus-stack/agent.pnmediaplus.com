    },
    {
      "parameters": {
        "jsCode": "const body = $('Webhook Trigger').item.json.body || {};\nconst contentRes = $('Verify Content Scope').item.json || [];\nconst threadRes = $('Verify Thread Scope').item.json || [];\n\nif (!body.organization_id || !body.thread_id || !body.content_item_id || !body.department_id) {\n  return { json: { valid: false, reason: 'Missing required SSOT inputs' } };\n}\nif (contentRes.length === 0) {\n  return { json: { valid: false, reason: 'Registry match failed: Content Item not found in Organization' } };\n}\nif (threadRes.length === 0) {\n  return { json: { valid: false, reason: 'Registry match failed: Thread not found in Organization' } };\n}\n\n// Add variables for downstream\nreturn { json: { valid: true, ...body } };"
      },
      "name": "Scope Resolve",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
