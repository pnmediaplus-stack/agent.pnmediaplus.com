    {
      "parameters": {
        "method": "GET",
        "url": "={{$env[\"SUPABASE_URL\"] || 'http://supabase:8000'}}/rest/v1/phase2_lessons_learned?order=createdAt.desc&limit=20&organization_id=eq.{{$json.organization_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Get Lessons",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1700,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Phase5ReadOnlyAuth",
          "name": "Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const strategy = $('Get Strategy').item.json[0];\nconst lessons = $input.item.json || [];\nif (lessons.length === 0) {\n  lessons.push({ lessonText: \"Our recent campaigns received very low engagement. The target audience (Gen Z) seems unresponsive to long-form text. They prefer short, punchy visual hooks.\" });\n}\n\nconst isVi = $('Webhook Trigger').item.json.body.locale === 'vi';\nconst lessonsText = lessons.map(l => `- ${l.lessonText}${l.metricHighlight ? ' (' + l.metricHighlight + ')' : ''}`).join('\\n');\nconst langInstruction = isVi \n  ? \"IMPORTANT: Your reasoning and proposed_direction MUST be written entirely in Vietnamese (Tiếng Việt).\" \n  : \"IMPORTANT: Your reasoning and proposed_direction MUST be written entirely in English.\";\n\nconst prompt = `You are a ruthless, data-driven Chief Marketing Officer AI.\\nYour current ACTIVE STRATEGY is: \"${strategy.name}\"\\nVision: \"${strategy.vision}\"\\n\\nHere are the recent lessons learned from the field:\\n${lessonsText}\\n\\nYour task: Evaluate if we should PIVOT (change direction) or STAY THE COURSE.\\nIf the lessons indicate failure or a mismatch, you MUST pivot. \\n${langInstruction}\\n\\nIf we should pivot, respond with STRICT JSON:\\n{\\n  \"should_pivot\": true,\\n  \"reasoning\": \"${isVi ? 'Giải thích lý do' : 'Detailed reasoning'}\",\\n  \"proposed_direction\": \"${isVi ? 'Hướng đi mới' : 'New direction'}\"\\n}\\nIf we should stay the course, respond with STRICT JSON:\\n{\\n  \"should_pivot\": false\\n}`;\n\nreturn { json: { prompt, organization_id: $('Webhook Trigger').item.json.body.organization_id, thread_id: $('Webhook Trigger').item.json.body.thread_id, content_item_id: $('Webhook Trigger').item.json.body.content_item_id, department_id: $('Webhook Trigger').item.json.body.department_id, strategy_id: strategy.id } };"
      },
      "name": "Format Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env[\"OPENAI_API_KEY\"]}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json.prompt}}\"\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {}
      },
      "name": "Agent 1 - CMO Strategist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1500,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json.choices[0].message.content;\nlet parsed;\ntry {\n  parsed = JSON.parse(response);\n} catch (e) {\n  throw new Error('STRUCTURAL_ERROR: Agent 1 did not return valid JSON.');\n}\nif (typeof parsed.should_pivot !== 'boolean') {\n  throw new Error('STRUCTURAL_ERROR: Agent 1 output is missing the boolean `should_pivot` key.');\n}\nreturn { json: { aiResult: parsed, organization_id: $('Format Prompt').item.json.organization_id, thread_id: $('Format Prompt').item.json.thread_id, content_item_id: $('Format Prompt').item.json.content_item_id, department_id: $('Format Prompt').item.json.department_id, strategy_id: $('Format Prompt').item.json.strategy_id } };"
      },
      "name": "Validate Agent 1 Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env[\"OPENAI_API_KEY\"]}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are Agent 4 - QA Gatekeeper. You must evaluate if Agent 1's decision to pivot or stay is logically sound given the lessons learned.\\nOutput MUST be strict JSON: { \\\"passed\\\": boolean, \\\"reason\\\": \\\"string\\\" }\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ 'Lessons Learned (Context):\\n' + $('Format Prompt').item.json.prompt + '\\n\\nAgent 1 Output:\\n' + JSON.stringify($json.aiResult, null, 2) }}\"\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" }\n}",
        "options": {}
      },
      "name": "Agent 4 - QA Gatekeeper",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1900,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.item.json.choices[0].message.content;\nlet parsed;\ntry {\n  parsed = JSON.parse(response);\n  if (typeof parsed.passed !== 'boolean' || typeof parsed.reason !== 'string') throw new Error('Missing fields');\n} catch (e) {\n  parsed = { passed: false, reason: 'QA_REJECT: Invalid QA Output Schema' };\n}\nreturn { json: { passed: parsed.passed, reason: parsed.reason, aiResult: $('Validate Agent 1 Output').item.json.aiResult, organization_id: $('Validate Agent 1 Output').item.json.organization_id, thread_id: $('Validate Agent 1 Output').item.json.thread_id, content_item_id: $('Validate Agent 1 Output').item.json.content_item_id, department_id: $('Validate Agent 1 Output').item.json.department_id, strategy_id: $('Validate Agent 1 Output').item.json.strategy_id } };"
      },
      "name": "QA Verdict Parser",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2700,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.passed}}",
              "value2": true
            }
          ]
