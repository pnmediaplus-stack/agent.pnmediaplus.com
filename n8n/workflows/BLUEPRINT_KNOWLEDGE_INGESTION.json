{
  "name": "Knowledge Base Ingestion Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "knowledge-ingestion",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 0 ],
      "notesInFlow": true,
      "notes": "Nhận payload { document_id, organization_id, file_path }"
    },
    {
      "parameters": {
        "url": "={{ ($env.SUPABASE_URL || '').replace(/\\/$/, '') + '/storage/v1/object/crm_knowledge_files/' + $json.body.file_path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "node-download-file",
      "name": "Download Document",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 200, 0 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{($env[\"SUPABASE_URL\"] || 'http://supabase:8000')}}/rest/v1/crm_knowledge_ingestion_runs?on_conflict=workflow_run_id",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_run_id\": \"{{$execution.id}}\",\n  \"document_id\": \"{{$json.body.document_id}}\",\n  \"organization_id\": \"{{$json.body.organization_id}}\",\n  \"file_path\": \"{{$json.body.file_path}}\",\n  \"file_name\": \"{{$json.body.file_name || ''}}\",\n  \"mime_type\": \"{{$json.body.mime_type || ''}}\",\n  \"status\": \"processing\",\n  \"payload\": {\n    \"source\": \"BLUEPRINT_KNOWLEDGE_INGESTION\",\n    \"document_id\": \"{{$json.body.document_id}}\",\n    \"organization_id\": \"{{$json.body.organization_id}}\",\n    \"file_path\": \"{{$json.body.file_path}}\"\n  }\n}",
        "options": {}
      },
      "id": "node-persist-ingestion-context",
      "name": "Persist Ingestion Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 200, 120 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "eUuuv1meIVSpZzFH",
          "name": "SupabaseAuth"
        }
      }
    },
    {
      "parameters": {
        "mode": "insert",
        "tableName": "crm_knowledge_chunks",
        "columns": "document_id, organization_id, content, metadata, embedding"
      },
      "id": "node-postgres-vector",
      "name": "Insert to Postgres Vector",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1,
      "position": [ 600, 0 ]
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "specificField",
        "binaryDataKey": "data",
        "loader": "auto",
        "textSplittingMode": "custom",
        "options": {}
      },
      "id": "node-pdf-loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [ 600, 200 ]
    },
    {
      "parameters": {
        "chunkSize": 1000,
        "chunkOverlap": 100
      },
      "id": "node-text-splitter",
      "name": "Recursive Character Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [ 600, 350 ]
    },
    {
      "parameters": {
        "model": "text-embedding-3-small"
      },
      "id": "node-openai-embeddings",
      "name": "OpenAI Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [ 600, 500 ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE public.crm_knowledge_documents SET status = 'ready' WHERE id = '{{ $('Webhook Trigger').first().json.body.document_id }}'"
      },
      "id": "node-update-status",
      "name": "Update Document Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.2,
      "position": [ 800, 0 ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{($env[\"SUPABASE_URL\"] || 'http://supabase:8000')}}/rest/v1/crm_knowledge_ingestion_runs?workflow_run_id=eq.{{$execution.id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"status\": \"ready\",\n  \"last_error\": null\n}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        }
      },
      "id": "node-update-ingestion-context-ready",
      "name": "Update Ingestion Context Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 1000, 0 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "eUuuv1meIVSpZzFH",
          "name": "SupabaseAuth"
        }
      }
    },
    {
      "parameters": {},
      "id": "node-ingestion-error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [ 0, 320 ],
      "notesInFlow": true,
      "notes": "Nhánh lỗi cho ingestion để document hỏng extraction tự chuyển failed thay vì kẹt processing."
    },
    {
      "parameters": {
        "url": "={{($env[\"SUPABASE_URL\"] || 'http://supabase:8000')}}/rest/v1/crm_knowledge_ingestion_runs?workflow_run_id=eq.{{$('Error Trigger').first().json.execution.id}}&select=workflow_run_id,document_id,organization_id,file_path,file_name,mime_type,status,last_error,payload",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "alwaysOutputData": true
        }
      },
      "id": "node-load-ingestion-context",
      "name": "Load Ingestion Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 200, 320 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "eUuuv1meIVSpZzFH",
          "name": "SupabaseAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ctxList = Array.isArray($input.first().json) ? $input.first().json : ($input.first().json ? [$input.first().json] : []);\nconst ctx = ctxList[0] || {};\nconst errorMessage = $('Error Trigger').first().json.execution?.error?.message || 'Unknown ingestion error';\n\nreturn {\n  json: {\n    workflow_run_id: ctx.workflow_run_id || $('Error Trigger').first().json.execution?.id || '',\n    document_id: ctx.document_id || '',\n    organization_id: ctx.organization_id || '',\n    error_message: errorMessage,\n    stage: 'text_extraction',\n    metadata: {\n      file_name: ctx.file_name || '',\n      file_path: ctx.file_path || '',\n      mime_type: ctx.mime_type || '',\n      status: ctx.status || 'processing'\n    }\n  }\n};"
      },
      "id": "node-format-ingestion-error",
      "name": "Format Ingestion Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 400, 320 ],
      "credentials": {}
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{($env[\"API_BASE_URL\"] || \"https://agent.pnmediaplus.com\")}}/api/crm/knowledge/ingestion-failed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json)}}",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-request-id",
              "value": "={{$execution.id}}-knowledge-failed"
            }
          ]
        }
      },
      "id": "node-mark-document-failed",
      "name": "Mark Document Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [ 600, 320 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "nlRh1UkRewsK7CCR",
          "name": "ControlPlaneAuth"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [ [ { "node": "Persist Ingestion Context", "type": "main", "index": 0 } ] ]
    },
    "Persist Ingestion Context": {
      "main": [ [ { "node": "Download Document", "type": "main", "index": 0 } ] ]
    },
    "Download Document": {
      "main": [ [ { "node": "Insert to Postgres Vector", "type": "main", "index": 0 } ] ]
    },
    "Default Data Loader": {
      "ai_document": [ [ { "node": "Insert to Postgres Vector", "type": "ai_document", "index": 0 } ] ]
    },
    "Recursive Character Text Splitter": {
      "ai_textSplitter": [ [ { "node": "Default Data Loader", "type": "ai_textSplitter", "index": 0 } ] ]
    },
    "OpenAI Embeddings": {
      "ai_embedding": [ [ { "node": "Insert to Postgres Vector", "type": "ai_embedding", "index": 0 } ] ]
    },
    "Insert to Postgres Vector": {
      "main": [ [ { "node": "Update Document Status", "type": "main", "index": 0 } ] ]
    },
    "Update Document Status": {
      "main": [ [ { "node": "Update Ingestion Context Ready", "type": "main", "index": 0 } ] ]
    },
    "Error Trigger": {
      "main": [ [ { "node": "Load Ingestion Context", "type": "main", "index": 0 } ] ]
    },
    "Load Ingestion Context": {
      "main": [ [ { "node": "Format Ingestion Error", "type": "main", "index": 0 } ] ]
    },
    "Format Ingestion Error": {
      "main": [ [ { "node": "Mark Document Failed", "type": "main", "index": 0 } ] ]
    }
  }
}
