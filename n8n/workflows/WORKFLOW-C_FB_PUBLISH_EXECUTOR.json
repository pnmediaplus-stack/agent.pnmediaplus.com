{
  "name": "WORKFLOW-C - FB Publish Executor",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "=https://jrgkpbjsqefvnhbiiutz.supabase.co/rest/v1/rpc/phase076_find_tenant_integration",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{$env[\"SUPABASE_SERVICE_ROLE_KEY\"]}}"
            }
          ]
        },
        "sendBody": true,
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $json.body.organization_id }}"
            },
            {
              "name": "p_integration_key",
              "value": "={{ $json.body.integration_key }}"
            }
          ]
        }
      },
      "name": "Fetch Facebook Integration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://agent.pnmediaplus.com/api/byok/redeem",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-broker-internal-secret",
              "value": "={{ $env[\"BROKER_INTERNAL_SECRET\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reference_token",
              "value": "={{ $json.vault_credential_ref }}"
            },
            {
              "name": "organization_id",
              "value": "={{ $json.organization_id }}"
            },
            {
              "name": "integration_key",
              "value": "={{ $json.integration_key }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Redeem BYOK Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://jrgkpbjsqefvnhbiiutz.supabase.co/rest/v1/phase2_assets?content_item_id=eq.{{ $('Webhook Trigger').item.json.body.content_item_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const assets = $input.all().map(item => item.json);\nconst caption = assets.find(a => a.asset_type === 'caption_output')?.asset_uri || '';\nconst image = assets.find(a => a.asset_type === 'visual_asset')?.asset_uri || '';\nconst accessToken = $('Redeem BYOK Token').item.json.data.access_token;\nconst pageId = $('Redeem BYOK Token').item.json.data.page_id;\nconst contentItemId = $('Webhook Trigger').item.json.body.content_item_id;\n\nreturn {\n  caption: caption,\n  image: image,\n  accessToken: accessToken,\n  pageId: pageId,\n  contentItemId: contentItemId\n};"
      },
      "name": "Extract FB Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{ $json.pageId }}/photos",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.image }}"
            },
            {
              "name": "message",
              "value": "={{ $json.caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $json.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Publish to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://agent.pnmediaplus.com/api/n8n/publish-callback",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-api-key",
              "value": "={{ $env[\"BROKER_INTERNAL_SECRET\"] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "job_id",
              "value": "={{ $('Extract FB Assets').item.json.contentItemId }}"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "fb_id",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fb-publish-executor",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    }
  ],
  "connections": {
    "Fetch Facebook Integration": {
      "main": [
        [
          {
            "node": "Redeem BYOK Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Redeem BYOK Token": {
      "main": [
        [
          {
            "node": "Fetch Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Assets": {
      "main": [
        [
          {
            "node": "Extract FB Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract FB Assets": {
      "main": [
        [
          {
            "node": "Publish to Facebook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Facebook": {
      "main": [
        [
          {
            "node": "Callback Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Fetch Facebook Integration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}