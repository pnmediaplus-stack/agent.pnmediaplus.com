    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"SUPABASE_URL\"] || '').replace(new RegExp('/$'), '') + '/rest/v1/rpc/phase076_get_publish_payload' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $('Webhook Trigger').item.json.body.organization_id }}"
            },
            {
              "name": "p_content_item_id",
              "value": "={{ $('Webhook Trigger').item.json.body.content_item_id }}"
            },
            {
              "name": "p_artifact_version_id",
              "value": "={{ $('Webhook Trigger').item.json.body.artifact_version_id }}"
            },
            {
              "name": "p_integration_key",
              "value": "={{ $('Webhook Trigger').item.json.body.integration_key }}"
            }
          ]
        }
      },
      "name": "Fetch Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $('Fetch Assets').item.json;\nconst accessToken = $('Redeem BYOK Token').item.json.data.access_token;\nconst pageId = $('Redeem BYOK Token').item.json.data.page_id;\nconst contentItemId = $('Webhook Trigger').item.json.body.content_item_id;\nconst organizationId = $('Webhook Trigger').item.json.body.organization_id;\nconst threadId = $('Webhook Trigger').item.json.body.thread_id;\n\nconst images = payload.visual_assets || [];\nlet batch = [];\n\nif (images.length === 1) {\n  const url = images[0].startsWith('http') ? images[0] : (($env[\"API_BASE_URL\"] || 'https://agent.pnmediaplus.com') + images[0]);\n  batch.push({\n    method: \"POST\",\n    relative_url: `${pageId}/photos`,\n    body: `url=${encodeURIComponent(url)}&message=${encodeURIComponent(payload.caption)}&published=true`\n  });\n} else if (images.length > 1) {\n  let attachedMedia = [];\n  images.forEach((img, i) => {\n    const url = img.startsWith('http') ? img : (($env[\"API_BASE_URL\"] || 'https://agent.pnmediaplus.com') + img);\n    batch.push({\n      method: \"POST\",\n      relative_url: `${pageId}/photos`,\n      name: `photo${i}`,\n      omit_response_on_success: false,\n      body: `url=${encodeURIComponent(url)}&published=false`\n    });\n    attachedMedia.push({ \"media_fbid\": `{result=photo${i}:$.id}` });\n  });\n  \n  batch.push({\n    method: \"POST\",\n    relative_url: `${pageId}/feed`,\n    body: `message=${encodeURIComponent(payload.caption)}&attached_media=${encodeURIComponent(JSON.stringify(attachedMedia))}`\n  });\n}\n\nreturn {\n  caption: payload.caption || '',\n  visual_assets: images,\n  batch_payload: JSON.stringify(batch),\n  accessToken: accessToken,\n  pageId: pageId,\n  contentItemId: contentItemId,\n  organizationId: organizationId,\n  threadId: threadId\n};"
      },
      "name": "Extract FB Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"SUPABASE_URL\"] || '').replace(new RegExp('/$'), '') + '/rest/v1/rpc/phase076_claim_facebook_publish' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $('Extract FB Assets').item.json.organizationId }}"
            },
            {
              "name": "p_content_item_id",
              "value": "={{ $('Extract FB Assets').item.json.contentItemId }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Claim Facebook Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1200,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v19.0' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "access_token",
              "value": "={{ $('Extract FB Assets').item.json.accessToken }}"
            },
            {
              "name": "batch",
              "value": "={{ $('Extract FB Assets').item.json.batch_payload }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Publish to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"NEXTJS_CONTROL_PLANE_BASE_URL\"] || '').replace(new RegExp('/$'), '') + '/api/phase3/publish-success' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"CONTROL_PLANE_SECRET\"] }}"
            },
            {
              "name": "x-request-id",
              "value": "={{ 'phase3-fb-' + $('Extract FB Assets').item.json.contentItemId + '-' + $json.id }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "organizationId",
              "value": "={{ $('Extract FB Assets').item.json.organizationId }}"
            },
            {
              "name": "contentItemId",
              "value": "={{ $('Extract FB Assets').item.json.contentItemId }}"
            },
            {
              "name": "channel",
              "value": "facebook"
            },
            {
              "name": "externalId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "externalUrl",
              "value": ""
            },
            {
              "name": "threadId",
              "value": "={{ $('Extract FB Assets').item.json.threadId }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1700,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fb-publish-executor",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        600
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env['NEXTJS_CONTROL_PLANE_BASE_URL'] || '').replace(new RegExp('/$'), '') + '/api/phase3/publish-error' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env['CONTROL_PLANE_SECRET'] }}"
            },
            {
              "name": "x-request-id",
              "value": "={{ 'phase3-fb-err-' + $execution.id }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "organizationId",
              "value": "={{ $json.organizationId }}"
            },
            {
              "name": "contentItemId",
              "value": "={{ $json.contentItemId }}"
            },
            {
              "name": "errorMessage",
              "value": "={{ $json.errorMessage }}"
            },
            {
              "name": "threadId",
              "value": "={{ $json.threadId }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "let threadId = '';\nlet contentItemId = 'unknown';\nlet organizationId = $env['ORGANIZATION_ID'] || '';\nlet errorMessage = $json.execution?.error?.message || 'Unknown Error';\n\ntry {\n  const webhook = $('Webhook Trigger').first();\n  if (webhook && webhook.json && webhook.json.body) {\n    const b = webhook.json.body;\n    if (b.threadId) threadId = b.threadId;\n    if (b.content_item_id) contentItemId = b.content_item_id;\n    if (b.organization_id) organizationId = b.organization_id;\n  }\n} catch (e) {}\n\nreturn {\n  json: {\n    threadId: threadId || 'fallback-thread',\n    contentItemId: contentItemId || 'unknown',\n    organizationId: organizationId || 'unknown',\n    errorMessage\n  }\n};"
      },
      "name": "Format Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const fbResponse = $json;\n\nif (fbResponse.error) {\n  throw new Error('Facebook API Error: ' + fbResponse.error.message);\n}\n\nlet externalId = '';\n\n// Facebook batch API returns an array of responses\nif (Array.isArray(fbResponse)) {\n  for (let i = 0; i < fbResponse.length; i++) {\n    const res = fbResponse[i];\n    if (res.code !== 200) {\n      const body = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;\n      const errorMsg = body?.error?.message || 'Unknown batch error';\n      throw new Error(`Facebook Batch Error at step ${i}: ${errorMsg}`);\n    }\n  }\n  \n  // Extract canonical ID from the last operation in the batch\n  const lastOp = fbResponse[fbResponse.length - 1];\n  const lastBody = typeof lastOp.body === 'string' ? JSON.parse(lastOp.body) : lastOp.body;\n  \n  // Graph API /photos returns { id: \"photo_id\", post_id: \"page_id_post_id\" }\n  // Graph API /feed returns { id: \"page_id_post_id\" }\n  externalId = lastBody?.post_id || lastBody?.id || '';\n} else if (fbResponse.id) {\n  externalId = fbResponse.post_id || fbResponse.id;\n} else {\n  throw new Error('Unexpected Facebook API response: ' + JSON.stringify(fbResponse));\n}\n\nreturn { \n  json: { \n    id: externalId, \n    status: 'ok', \n    fbResponse \n  } \n};"
      },
      "id": "validate-fb-publish-node",
      "name": "Validate FB Publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        300
      ]
    }
  ],
