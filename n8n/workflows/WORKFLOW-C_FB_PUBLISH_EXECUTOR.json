{
  "name": "WORKFLOW-C - FB Publish Executor",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"SUPABASE_URL\"] || '').replace(new RegExp('/$'), '') + '/rest/v1/rpc/phase076_find_tenant_integration' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "sendBody": true,
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $json.body.organization_id }}"
            },
            {
              "name": "p_integration_key",
              "value": "={{ $json.body.integration_key }}"
            }
          ]
        }
      },
      "name": "Fetch Facebook Integration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"NEXTJS_CONTROL_PLANE_BASE_URL\"] || '').replace(new RegExp('/$'), '') + '/api/byok/redeem' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-broker-internal-secret",
              "value": "={{ $env[\"BROKER_INTERNAL_SECRET\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "reference_token",
              "value": "={{ $('Webhook Trigger').item.json.body.reference_token }}"
            },
            {
              "name": "organization_id",
              "value": "={{ $('Webhook Trigger').item.json.body.organization_id }}"
            },
            {
              "name": "integration_key",
              "value": "={{ $('Webhook Trigger').item.json.body.integration_key }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Redeem BYOK Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"SUPABASE_URL\"] || '').replace(new RegExp('/$'), '') + '/rest/v1/rpc/phase076_get_publish_payload' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $('Webhook Trigger').item.json.body.organization_id }}"
            },
            {
              "name": "p_content_item_id",
              "value": "={{ $('Webhook Trigger').item.json.body.content_item_id }}"
            },
            {
              "name": "p_artifact_version_id",
              "value": "={{ $('Webhook Trigger').item.json.body.artifact_version_id }}"
            },
            {
              "name": "p_integration_key",
              "value": "={{ $('Webhook Trigger').item.json.body.integration_key }}"
            }
          ]
        }
      },
      "name": "Fetch Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const payload = $('Fetch Assets').item.json;\nconst accessToken = $('Redeem BYOK Token').item.json.data.access_token;\nconst pageId = $('Redeem BYOK Token').item.json.data.page_id;\nconst contentItemId = $('Webhook Trigger').item.json.body.content_item_id;\nconst organizationId = $('Webhook Trigger').item.json.body.organization_id;\nconst threadId = $('Webhook Trigger').item.json.body.thread_id;\n\nreturn {\n  caption: payload.caption || '',\n  image: payload.image || '',\n  accessToken: accessToken,\n  pageId: pageId,\n  contentItemId: contentItemId,\n  organizationId: organizationId,\n  threadId: threadId\n};"
      },
      "name": "Extract FB Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"SUPABASE_URL\"] || '').replace(new RegExp('/$'), '') + '/rest/v1/rpc/phase076_claim_facebook_publish' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"SUPABASE_SERVICE_ROLE_KEY\"] }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_organization_id",
              "value": "={{ $('Extract FB Assets').item.json.organizationId }}"
            },
            {
              "name": "p_content_item_id",
              "value": "={{ $('Extract FB Assets').item.json.contentItemId }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Claim Facebook Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1200,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://graph.facebook.com/v19.0/' + $('Extract FB Assets').item.json.pageId + '/photos' }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $('Extract FB Assets').item.json.image.startsWith('http') ? $('Extract FB Assets').item.json.image : ($env[\"API_BASE_URL\"] || 'https://agent.pnmediaplus.com') + $('Extract FB Assets').item.json.image }}"
            },
            {
              "name": "message",
              "value": "={{ $('Extract FB Assets').item.json.caption }}"
            },
            {
              "name": "access_token",
              "value": "={{ $('Extract FB Assets').item.json.accessToken }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Publish to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env[\"NEXTJS_CONTROL_PLANE_BASE_URL\"] || '').replace(new RegExp('/$'), '') + '/api/phase3/publish-success' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env[\"CONTROL_PLANE_SECRET\"] }}"
            },
            {
              "name": "x-request-id",
              "value": "={{ 'phase3-fb-' + $('Extract FB Assets').item.json.contentItemId + '-' + $json.id }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "organizationId",
              "value": "={{ $('Extract FB Assets').item.json.organizationId }}"
            },
            {
              "name": "contentItemId",
              "value": "={{ $('Extract FB Assets').item.json.contentItemId }}"
            },
            {
              "name": "channel",
              "value": "facebook"
            },
            {
              "name": "externalId",
              "value": "={{ $json.id }}"
            },
            {
              "name": "externalUrl",
              "value": ""
            },
            {
              "name": "threadId",
              "value": "={{ $('Extract FB Assets').item.json.threadId }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Callback Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1500,
        300
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fb-publish-executor",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    }
  ],
  "connections": {
    "Fetch Facebook Integration": {
      "main": [
        [
          {
            "node": "Redeem BYOK Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Redeem BYOK Token": {
      "main": [
        [
          {
            "node": "Fetch Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Assets": {
      "main": [
        [
          {
            "node": "Extract FB Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract FB Assets": {
      "main": [
        [
          {
            "node": "Claim Facebook Publish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Facebook Publish": {
      "main": [
        [
          {
            "node": "Publish to Facebook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Facebook": {
      "main": [
        [
          {
            "node": "Callback Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Fetch Facebook Integration",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}