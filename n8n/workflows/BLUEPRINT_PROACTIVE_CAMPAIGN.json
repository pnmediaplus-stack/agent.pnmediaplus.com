      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const campaign = $input.item.json;\nreturn { json: { campaign_id: campaign.id, hours: campaign.condition_hours_inactive, channel_id: campaign.channel_id, prompt: campaign.system_prompt_override, org_id: campaign.organization_id } };"
      },
      "id": "bcb661fa-1ace-4dcd-a54e-0ebc6a18839d",
      "name": "Format Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2864,
        -528
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=\nSELECT t.id as thread_id, c.id as customer_id\nFROM public.crm_threads t\nJOIN public.crm_customers c ON c.id = t.customer_id\nWHERE t.channel_id = '{{ $json.channel_id }}'\n  AND t.status != 'human_handling'\n  AND c.customer_segment IS DISTINCT FROM 'opt-out'\n  AND t.last_message_at < NOW() - INTERVAL '{{ $json.hours }} hours'\n  AND NOT EXISTS (\n    SELECT 1 FROM public.crm_campaign_logs cl\n    WHERE cl.campaign_id = '{{ $json.campaign_id }}'\n      AND cl.thread_id = t.id\n  );",
        "options": {}
      },
      "id": "5f03bbbd-ec23-4d74-b8f3-e20c6ef08a8b",
      "name": "Find Eligible Threads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        3072,
        -528
      ],
      "credentials": {
        "postgres": {
          "id": "EhOYcO8YGhLwldqf",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "c3a3bac2-e81b-40af-a7bf-001c7bbb9d10",
      "name": "Loop Through Threads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [
        3264,
        -528
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=\nSELECT COALESCE(json_agg(json_build_object('content', content, 'sender_type', sender_type) ORDER BY created_at ASC), '[]'::json) as history\nFROM (\n  SELECT content, sender_type, created_at \n  FROM public.crm_messages \n  WHERE thread_id = '{{ $json.thread_id }}'\n  ORDER BY created_at DESC \n  LIMIT 10\n) sub;",
        "options": {}
      },
      "id": "20e0d9a4-048c-4763-88b4-e00c43aaf0d4",
      "name": "Get Chat History",
