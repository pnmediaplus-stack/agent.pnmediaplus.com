{
  "name": "BLUEPRINT_PROACTIVE_CAMPAIGN",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "e2a3c75d-16f3-4e4b-9e8c-85a73e4b7891",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=\nSELECT * FROM public.crm_campaign_rules \nWHERE is_active = true \nAND organization_id = '{{ $env.ORGANIZATION_ID }}';"
      },
      "id": "c62f23ea-8b1e-450f-a496-e17f0a911e3b",
      "name": "Get Active Campaigns",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [200, 0],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const campaign = $input.item.json;\nreturn { json: { campaign_id: campaign.id, hours: campaign.condition_hours_inactive, channel_id: campaign.channel_id, prompt: campaign.system_prompt_override, org_id: campaign.organization_id } };"
      },
      "id": "893c834f-9e7f-4f2a-89a1-0294e50d1e34",
      "name": "Format Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=\nSELECT t.id as thread_id, c.id as customer_id\nFROM public.crm_threads t\nJOIN public.crm_customers c ON c.id = t.customer_id\nWHERE t.channel_id = '{{ $json.channel_id }}'\n  AND t.status != 'human_handling'\n  AND c.customer_segment IS DISTINCT FROM 'opt-out'\n  AND t.last_message_at < NOW() - INTERVAL '{{ $json.hours }} hours'\n  AND NOT EXISTS (\n    SELECT 1 FROM public.crm_campaign_logs cl\n    WHERE cl.campaign_id = '{{ $json.campaign_id }}'\n      AND cl.thread_id = t.id\n  )\n  AND (\n    SELECT sender_type \n    FROM public.crm_messages m \n    WHERE m.thread_id = t.id \n    ORDER BY created_at DESC \n    LIMIT 1\n  ) = 'customer';"
      },
      "id": "a93b841a-8b1e-450f-a496-e17f0a911e3b",
      "name": "Find Eligible Threads",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [600, 0],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "f83b23ea-8b1e-450f-a496-e17f0a911e3b",
      "name": "Loop Through Threads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [800, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=\nSELECT content, sender_type \nFROM public.crm_messages \nWHERE thread_id = '{{ $json.thread_id }}'\nORDER BY created_at DESC \nLIMIT 10;"
      },
      "id": "194b841a-8b1e-450f-a496-e17f0a911e3b",
      "name": "Get Chat History",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [1000, 0],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres",
          "name": "Supabase Postgres"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.OPENAI_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": {{ JSON.stringify($('Format Campaign').item.json.prompt) }}\n    },\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify(JSON.stringify($input.all().map(i => i.json))) }}\n    }\n  ],\n  \"temperature\": 0.7\n}",
        "options": {}
      },
      "id": "384b841a-8b1e-450f-a496-e17f0a911e3b",
      "name": "Generate AI Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_BASE_URL || 'https://agent.pnmediaplus.com' }}/api/internal/crm/messages/dispatch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.CONTROL_PLANE_SECRET}}"
            },
            {
              "name": "x-internal-secret",
              "value": "{{$env.CONTROL_PLANE_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"organization_id\": \"{{ $('Format Campaign').item.json.org_id }}\",\n  \"thread_id\": \"{{ $('Loop Through Threads').item.json.thread_id }}\",\n  \"content\": {{ JSON.stringify($json.choices[0].message.content) }},\n  \"sender_type\": \"bot\"\n}"
      },
      "id": "494b841a-8b1e-450f-a496-e17f0a911e3b",
      "name": "Dispatch Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1400, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=\nINSERT INTO public.crm_campaign_logs (organization_id, campaign_id, thread_id, status)\nVALUES ('{{ $('Format Campaign').item.json.org_id }}', '{{ $('Format Campaign').item.json.campaign_id }}', '{{ $('Loop Through Threads').item.json.thread_id }}', 'sent');"
      },
      "id": "594b841a-8b1e-450f-a496-e17f0a911e3b",
      "name": "Log Campaign Sent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [1600, 0],
      "credentials": {
        "postgres": {
          "id": "supabase_postgres",
          "name": "Supabase Postgres"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Active Campaigns",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Campaigns": {
      "main": [
        [
          {
            "node": "Format Campaign",
            "type": "main",
            "index": 0
