            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate AI Message": {
      "main": [
        [
          {
            "node": "Dispatch Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Message": {
      "main": [
        [
          {
            "node": "Log Campaign Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Campaign Sent": {
      "main": [
