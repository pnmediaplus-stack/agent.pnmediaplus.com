    {
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"SUPABASE_URL\"] || \"http://supabase:8000\"}}/rest/v1/rpc/phase075_n8n_append_chat_message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
