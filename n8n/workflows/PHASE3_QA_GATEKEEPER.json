      "id": "dae4f3d1-ecd3-49af-ba36-18cb50e75b58"
    },
    {
      "parameters": {
        "jsCode": "let response = $json.choices[0].message.content;\ntry { response = JSON.parse(response); } catch(e){}\nreturn { json: { result: response, originalBody: $(\"Webhook\").first().json.body } };"
      },
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
