      "parameters": {
        "jsCode": "const aiResult = JSON.parse($input.item.json.choices[0].message.content);\nconst ideas = aiResult.ideas || [];\nconst campaignId = $('Create Campaign').item.json[0].id;\n\nconst contentItems = ideas.map(idea => ({\n  content_key: `camp_${Date.now()}_${Math.floor(Math.random() * 10000)}`,\n  owner_ref: 'agent_campaign_planner',\n  title: idea.title,\n  brief: idea.brief,\n  state: 'idea',\n  campaign_id: campaignId\n}));\n\nreturn { json: { contentItems, campaignId, ideasGenerated: ideas.length } };"
      },
