{
  "name": "Phase 3 - Auto Publisher (Telegram)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://jrgkpbjsqefvnhbiiutz.supabase.co/rest/v1/phase2_content_items?state=eq.scheduled",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_gGztlsTgCYmzn_JvkEBteQ_jueGATy4"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_gGztlsTgCYmzn_JvkEBteQ_jueGATy4"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Scheduled Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "data",
        "options": {}
      },
      "name": "Split Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://jrgkpbjsqefvnhbiiutz.supabase.co/rest/v1/phase2_assets?content_item_id=eq.{{ $json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_gGztlsTgCYmzn_JvkEBteQ_jueGATy4"
            },
            {
              "name": "Authorization",
              "value": "Bearer sb_publishable_gGztlsTgCYmzn_JvkEBteQ_jueGATy4"
            }
          ]
        },
        "options": {}
      },
      "name": "Fetch Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const assets = $input.item.json.data;\nconst caption = assets.find(a => a.asset_type === 'caption_output')?.asset_uri || 'No caption';\nconst image = assets.find(a => a.asset_type === 'visual_asset')?.asset_uri || '';\nconst contentItemId = assets[0]?.content_item_id || '';\n\nreturn {\n  caption: caption,\n  image: image,\n  contentItemId: contentItemId\n};"
      },
      "name": "Extract Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "CHAT_ID_HERE",
        "photo": "={{ $json.image }}",
        "additionalFields": {
          "caption": "={{ $json.caption }}"
        }
      },
      "name": "Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "CREATE_CREDENTIAL_ID_HERE",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://agent.pnmediaplus.com/api/phase3/publish-success",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer pn_media_os_super_secret_key_2026_xyz"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "contentItemId",
              "value": "={{ $('Extract Assets').item.json.contentItemId }}"
            },
            {
              "name": "channel",
              "value": "telegram"
            },
            {
              "name": "externalId",
              "value": "={{ $json.message_id || Date.now() }}"
            },
            {
              "name": "externalUrl",
              "value": "https://t.me/c/CHAT_ID_HERE/"
            }
          ]
        },
        "options": {}
      },
      "name": "Confirm Publish API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        300
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch Scheduled Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Scheduled Items": {
      "main": [
        [
          {
            "node": "Split Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Items": {
      "main": [
        [
          {
            "node": "Fetch Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Assets": {
      "main": [
        [
          {
            "node": "Extract Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Assets": {
      "main": [
        [
          {
            "node": "Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram": {
      "main": [
        [
          {
            "node": "Confirm Publish API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}