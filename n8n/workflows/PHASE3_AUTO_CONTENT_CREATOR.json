{
  "name": "Phase 3 - Auto Content Creator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-content",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        100,
        100
      ],
      "webhookId": "generate-content-webhook-id"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env[\"SUPABASE_URL\"] || 'http://supabase:8000'}}/rest/v1/phase2_content_items?id=eq.{{$json.body.contentItemId}}&organization_id=eq.{{$json.body.organization_id}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "name": "Get Item (Webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        300,
        100
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SupabaseAuth",
          "name": "Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst ideaItem = $('Get Item (Webhook)').item.json[0] || $('Get Item (Webhook)').item.json;\nconst govData = $('Fetch Governance Registry').item.json.data;\n\nif (!ideaItem) {\n  throw new Error('CONTENT_ITEM_NOT_FOUND');\n}\n\n// Find agents\nconst agent1 = govData.agents.find(a => a.role_id === 'marketing_agent_1_viral_research_angle');\nconst agent2 = govData.agents.find(a => a.role_id === 'marketing_agent_2_social_caption_architect');\nconst agent3 = govData.agents.find(a => a.role_id === 'marketing_agent_3_image_prompt_architect');\n\nconst prompt = `You are an orchestration of 3 specialized AI Marketing Agents working in sequence.\nYou MUST respect the capabilities (MUST) and strictly avoid the prohibitions (MUST NOT) of each agent.\nThe governance rules are currently in DRAFT_METADATA_ONLY mode.\n\n[AGENT 1: VIRAL RESEARCH ANGLE]\nMUST: ${agent1.capability_boundary.must.join(', ')}\nMUST NOT: ${agent1.capability_boundary.must_not.join(', ')}\n\n[AGENT 2: SOCIAL CAPTION ARCHITECT]\nMUST: ${agent2.capability_boundary.must.join(', ')}\nMUST NOT: ${agent2.capability_boundary.must_not.join(', ')}\n\n[AGENT 3: IMAGE PROMPT ARCHITECT]\nMUST: ${agent3.capability_boundary.must.join(', ')}\nMUST NOT: ${agent3.capability_boundary.must_not.join(', ')}\n\n---\nIdea Title: ${ideaItem.title}\nBrief: ${ideaItem.brief || 'No brief provided.'}\n\nRespond in STRICT JSON format, fulfilling the exact outputs required by each agent without crossing boundaries:\n{\n  \"agent_1_research_packet\": \"Viral angles and pain points based on the brief...\",\n  \"agent_2_publish_ready_caption\": \"The engaging caption text...\",\n  \"agent_3_image_prompt\": \"A highly detailed image prompt...\"\n}\n`;\n\nreturn { json: { prompt: prompt, item: ideaItem, tenant_id: ideaItem.organization_id, organization_id: ideaItem.organization_id } };\n"
      },
      "name": "Format Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"API_BASE_URL\"]}}/api/phase2/ai-broker",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gpt-4o-mini\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"{{$json.prompt}}\"\n    }\n  ],\n  \"response_format\": { \"type\": \"json_object\" },\n  \"tenant_id\": \"{{$json.tenant_id}}\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-request-id",
              "value": "={{$execution.id}}-{{$position}}"
            }
          ]
        },
        "options": {}
      },
      "name": "AI Broker (Text)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ControlPlaneAuth",
          "name": "Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst responseText = $input.item.json.choices[0].message.content || '{}';\nconst item = $('Format Prompt').item.json.item;\nconst tenant_id = $('Format Prompt').item.json.tenant_id;\nlet parsed = {};\ntry {\n  parsed = JSON.parse(responseText);\n} catch(e) {\n  throw new Error('AI Response was not valid JSON');\n}\n\nreturn { \n  json: { \n    id: item.id, \n    organization_id: item.organization_id,\n    tenant_id: tenant_id,\n    textContent: {\n      agent_1_research_packet: parsed.agent_1_research_packet,\n      agent_2_publish_ready_caption: parsed.agent_2_publish_ready_caption,\n      agent_3_image_prompt: parsed.agent_3_image_prompt\n    },\n    item: item\n  } \n};\n  "
      },
      "name": "Parse Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"API_BASE_URL\"]}}/api/phase2/ai-broker",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"dall-e-3\",\n  \"prompt\": \"{{$json.textContent.agent_3_image_prompt}}\",\n  \"n\": 1,\n  \"size\": \"1024x1024\",\n  \"tenant_id\": \"{{$json.tenant_id}}\",\n  \"endpointUrl\": \"https://api.openai.com/v1/images/generations\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-request-id",
              "value": "={{$execution.id}}-img-{{$position}}"
            }
          ]
        },
        "options": {}
      },
      "name": "AI Broker (Image)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1300,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ControlPlaneAuth",
          "name": "Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst textContent = $('Parse Text').item.json.textContent;\nconst item = $('Parse Text').item.json.item;\nlet imageUrl = \"https://placehold.co/1024x1024?text=Image+Generation+Failed\";\nif ($input.item.json.data && $input.item.json.data[0] && $input.item.json.data[0].url) {\n  imageUrl = $input.item.json.data[0].url;\n}\n\nconst contentItemId = item.id;\nconst assetsBody = [\n  { content_item_id: contentItemId, owner_ref: 'agent_content_creator', asset_type: 'viral_research_packet', asset_key: 'res_' + Date.now(), asset_uri: textContent.agent_1_research_packet },\n  { content_item_id: contentItemId, owner_ref: 'agent_content_creator', asset_type: 'visual_asset', asset_key: 'vis_' + Date.now(), asset_uri: imageUrl },\n  { content_item_id: contentItemId, owner_ref: 'agent_content_creator', asset_type: 'caption_output', asset_key: 'cap_' + Date.now(), asset_uri: textContent.agent_2_publish_ready_caption }\n];\n\nreturn { json: { assetsBody, contentItemId } };\n"
      },
      "name": "Format Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env[\"SUPABASE_URL\"] || 'http://supabase:8000'}}/rest/v1/phase2_assets",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify($json.assetsBody)}}",
        "options": {}
      },
      "name": "Insert Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1700,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SupabaseAuth",
          "name": "Header Auth"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env[\"SUPABASE_URL\"] || 'http://supabase:8000'}}/rest/v1/phase2_content_items?id=eq.{{$('Format Assets').item.json.contentItemId}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"state\": \"QA_ready\" }",
        "options": {}
      },
      "name": "Update State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1900,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "SupabaseAuth",
          "name": "Header Auth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return { json: { status: 'OK', message: 'Content generated successfully' } };"
      },
      "name": "Format Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env[\"API_BASE_URL\"] || 'http://localhost:3000'}}/api/governance/marketing-agents",
        "authentication": "none",
        "options": {}
      },
      "name": "Fetch Governance Registry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.state}}",
              "value2": "ready"
            }
          ]
        }
      },
      "name": "Validate Governance State",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        600,
        100
      ]
    },
    {
      "parameters": {
        "errorMessage": "=Governance Registry is blocked: {{$json.reason}}"
      },
      "name": "Governance Blocked Escalate",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        800,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Get Item (Webhook)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Item (Webhook)": {
      "main": [
        [
          {
            "node": "Fetch Governance Registry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Governance Registry": {
      "main": [
        [
          {
            "node": "Validate Governance State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Governance State": {
      "main": [
        [
          {
            "node": "Format Prompt",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Governance Blocked Escalate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Prompt": {
      "main": [
        [
          {
            "node": "AI Broker (Text)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Broker (Text)": {
      "main": [
        [
          {
            "node": "Parse Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Text": {
      "main": [
        [
          {
            "node": "AI Broker (Image)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Broker (Image)": {
      "main": [
        [
          {
            "node": "Format Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Assets": {
      "main": [
        [
          {
            "node": "Insert Assets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Assets": {
      "main": [
        [
          {
            "node": "Update State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update State": {
      "main": [
        [
          {
            "node": "Format Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}