    {
      "parameters": {
        "jsCode": "const incoming = $('Webhook Trigger').first().json.body || {};\nconst raw = $input.first().json;\n\nlet doc = raw;\nif (Array.isArray(raw)) doc = raw[0] || null;\nif (raw && Array.isArray(raw.data)) doc = raw.data[0] || null;\n\nif (!doc || !doc.id) {\n  throw new Error('KNOWLEDGE_DOCUMENT_NOT_FOUND_OR_TENANT_MISMATCH');\n}\n\nif (String(doc.organization_id || '') !== String(incoming.organization_id || '')) {\n  throw new Error('KNOWLEDGE_TENANT_MISMATCH');\n}\n\nif (!doc.file_path) {\n  throw new Error('KNOWLEDGE_FILE_PATH_MISSING_IN_DB');\n}\n\nif (incoming.file_path && String(incoming.file_path) !== String(doc.file_path)) {\n  throw new Error('KNOWLEDGE_FILE_PATH_MISMATCH');\n}\n\nconst allowedFiles = new Set([\"02_FEATURE_CATALOG.md\", \"03_BUSINESS_WORKFLOW_GUIDE.md\", \"08_PRODUCT_SCOPE_AND_SERVICE_BOUNDARY.md\", \"12_MASTER_PRODUCT_DOCUMENTATION.md\", \"03_USER_OPERATION_GUIDE.md\", \"04_ROLE_AND_ACCESS_FAQ.md\", \"05_KNOWN_LIMITATIONS.md\", \"06_SUPPORT_AND_ESCALATION_RULES.md\", \"08_CHANGE_REQUEST_AND_CUSTOM_FEATURE_POLICY.md\", \"07_SUBSCRIPTION_AND_SERVICE_FAQ_v1.1.md\", \"PN_AGENCY_CRM_PRICE_MATRIX_v1.0.md\", \"01_SOCIAL_CHANNEL_BUILDING_SERVICE_v1.1.md\", \"02_FANPAGE_SOCIAL_CARE_SERVICE_v1.1.md\", \"03_PAID_ADS_SERVICE_v1.1.md\", \"04_WEBSITE_SERVICE_v1.1.md\", \"05_N8N_AUTOMATION_SERVICE_v1.0.md\", \"06_AI_CHATBOT_SERVICE_v1.0.md\", \"07_MEDIA_PRODUCTION_SERVICE_v1.0.md\", \"01_PN_MASTER_COMMERCIAL_PRODUCT_MATRIX_v1.0.md\", \"02_PN_SERVICE_DIFFERENTIATION_AND_BUYING_GUIDE_v1.0.md\", \"04_PN_SOLUTION_COMBO_MATRIX_v1.0.md\"]);\nconst fileName = String(doc.file_name || String(doc.file_path).split('/').pop() || '').trim();\n\nif (!allowedFiles.has(fileName)) {\n  throw new Error('KNOWLEDGE_FILE_NOT_IN_ACTIVE_CANONICAL_MANIFEST: ' + fileName);\n}\n\nreturn [{\n  json: {\n    document_id: doc.id,\n    organization_id: doc.organization_id,\n    file_path: doc.file_path,\n    file_name: fileName,\n    mime_type: doc.mime_type || '',\n    document_status_before_ingestion: doc.status || '',\n    canonical_manifest: 'PN_TELESALES_FINAL_KNOWLEDGE_PACKAGE_v1.0',\n    canonical_allowed: true\n  }\n}];"
      },
